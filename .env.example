# Copy this file to .env and fill in your values

# Market: NSE (India) or US
MARKET=NSE

# Trading mode: simulation | zerodha
TRADING_MODE=simulation

# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
# 1. Go to https://developers.kite.trade/ and create a new app
# 2. Set the Redirect URL to:  http://127.0.0.1:5000/zerodha/callback
# 3. Paste your API key and secret below
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# CNC = delivery (hold overnight) | MIS = intraday (auto-square off at 3:15 PM)
ZERODHA_PRODUCT=CNC

# ── Simulation ────────────────────────────────────────────────────────────────
# Starting virtual capital (used when TRADING_MODE=simulation)
INITIAL_CAPITAL=100000

# ── Web server ────────────────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=5000
